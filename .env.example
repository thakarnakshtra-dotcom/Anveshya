# Copy this file to .env (untracked by git) for local `npm run dev`.
# In production, set this as an environment variable in the Netlify
# dashboard instead (Site settings -> Environment variables) — never commit
# the real value.

# Google Apps Script "Web app" URL that the /feedback function forwards
# submissions to. See FEEDBACK_SETUP.md for how to create one.
FEEDBACK_WEBHOOK_URL=

# Supabase project used by the newsletter signup function. Service key,
# not the anon/public one — this is server-side only, never shipped to
# the browser. See NEWSLETTER_SETUP.md.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: only needed for the weekly signup-digest email
# (netlify/functions/newsletter-digest.js). Leave blank to skip it —
# signups still save fine without these. See NEWSLETTER_SETUP.md.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NOTIFY_EMAIL=
