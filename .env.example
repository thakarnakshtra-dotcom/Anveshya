# Copy this file to .env (untracked by git) for local `npm run dev`.
# In production, set this as an environment variable in the Netlify
# dashboard instead (Site settings -> Environment variables) — never commit
# the real value.

# Google Apps Script "Web app" URL that the /feedback function forwards
# submissions to. See FEEDBACK_SETUP.md for how to create one.
FEEDBACK_WEBHOOK_URL=
